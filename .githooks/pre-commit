#!/bin/sh

echo "Updating generated site indexes..."

node scripts/generate-site-indexes.mjs

if [ $? -ne 0 ]; then
  echo "Site index generation failed. Commit cancelled."
  exit 1
fi

if ! git diff --quiet -- '*.html'; then
  echo "Generated HTML or page edits need staging. Review and stage the HTML changes, then commit again."
  exit 1
fi

git add content/content-index.json sitemap.xml

echo "Site indexes updated and staged."