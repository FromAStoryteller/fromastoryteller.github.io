{
  // Frontend release: contributor discovery and signed-in library navigation.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fas-site-production",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "previews": {},
  "routes": [
    {
      "pattern": "fromastoryteller.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist-production",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/read/",
      "/stories/*",
      "/blog/*",
      "/games/*",
      "/tools/*",
      "/videos/*"
    ]
  },
  "main": "cloudflare-worker.mjs",
  "tsconfig": "tsconfig.cloudflare.json"
}
