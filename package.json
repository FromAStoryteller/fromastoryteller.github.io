{
  "name": "from-a-storyteller",
  "private": true,
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/generate-site-indexes.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:account-policies": "node scripts/check-fas-policy-history.mjs",
    "test:security:api": "node scripts/test-fas-security-api.mjs",
    "test:security:sql": "node --test tests/fas-security-database.test.mjs",
    "validate:references": "node scripts/validate-references.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:cloudflare-preview": "wrangler deploy",
    "verify:cloudflare": "node scripts/verify-cloudflare.mjs",
    "build:cloudflare-production": "node scripts/build-cloudflare.mjs --production",
    "preview:cloudflare-production": "wrangler dev --config wrangler.production.jsonc --ip 127.0.0.1 --port 8788",
    "deploy:cloudflare-production": "wrangler deploy --config wrangler.production.jsonc",
    "build:auth-client": "node scripts/build-fas-auth-client.mjs",
    "dev:accounts:local": "node scripts/start-fas-account-local.mjs",
    "dev:accounts:dev": "node scripts/start-fas-account-dev.mjs",
    "test:accounts:dev": "node scripts/run-fas-dev-tests.mjs",
    "test:auth:local": "node scripts/test-fas-auth-local.mjs",
    "test:signup:local": "node scripts/test-fas-signup-local.mjs",
    "test:sessions:local": "node scripts/test-fas-sessions-local.mjs",
    "test:recovery:local": "node scripts/test-fas-recovery-local.mjs",
    "test:settings:local": "node scripts/test-fas-settings-local.mjs",
    "test:policies:local": "node scripts/test-fas-policies-local.mjs",
    "test:lifecycle:local": "node scripts/test-fas-lifecycle-local.mjs",
    "test:restore:local": "node scripts/test-fas-restore-local.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "vite": "^8.2.2",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3"
  }
}
